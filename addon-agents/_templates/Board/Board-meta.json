  "version": "1.1.0",
  "display_name": {
    "ko": "게시판 (Board)",
    "en": "Board"
  },
  "description": {
    "ko": "게시글과 댓글을 작성·조회·수정·삭제하는 CRUD 게시판 앱입니다. 전용 화면(front)을 포함하여 활성화 시 좌측 메뉴에 표시되며, AI 어시스턴트로도 게시물을 관리할 수 있습니다.",
    "en": "A CRUD board app for creating, viewing, editing, and deleting posts and comments. Includes a dedicated screen (front) shown in the left menu when active; posts can also be managed via the AI Assistant."
  },
  "capabilities": [
    {
      "verb": "manage",
      "domain": "app.board",
      "description": "게시판 게시물을 생성·조회·수정·삭제합니다",
