          },
          "content": {
            "type": "string"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "author_id": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          }
        }
      }
    }
  ],
  "governance": {
