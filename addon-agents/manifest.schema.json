{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secuardian.local/schemas/addon-manifest-v2.json",
  "title": "SeCuardian-Basic Addon Manifest v2 ({Name}-meta.json)",
  "description": "SeCuardian 방언. 레거시 alias(key→agent_key, type→agent_type, name→display_name, min_platform_version→requires.core, db_tables→tables_owned, dependencies[]→dependencies.python) 는 런타임(app/services/addon_manifest.py)이 자동 승격한다. 알 수 없는 키는 보존된다.",
  "type": "object",
  "$defs": {
    "langText": {
      "oneOf": [
        { "type": "string" },
        { "type": "object", "additionalProperties": { "type": "string" }, "description": "{\"ko\": ..., \"en\": ..., \"jp\": ...}" }
      ]
    },
    "stringList": { "type": "array", "items": { "type": "string" } }
  },
  "properties": {
    "schema_version": { "type": "integer", "enum": [1, 2], "default": 1 },
    "agent_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,40}$",
      "description": "생략 시 zip 파일명 stem 소문자. API prefix /api/addon/{agent_key}"
    },
    "display_name": { "$ref": "#/$defs/langText" },
    "description": { "$ref": "#/$defs/langText" },
    "description_en": { "type": "string", "description": "레거시 병행 키 (description 이 문자열일 때 en)" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$", "default": "1.0.0" },
    "agent_type": {
      "type": "string",
      "enum": ["app", "service", "tool-proxy", "rag", "reviewer", "execution", "hitl", "memory", "federation", "shell"],
      "default": "app"
    },
    "categories": { "$ref": "#/$defs/stringList" },
    "has_front": { "type": "boolean", "description": "생략 시 {Name}-front.tsx 존재 여부로 판단" },
    "dependencies": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "python": { "$ref": "#/$defs/stringList", "description": "PEP 508 스펙. 설치 시 uv pip install (ADDON_DEPS_INSTALL)" }
          }
        },
        { "$ref": "#/$defs/stringList", "description": "레거시: python 목록" }
      ]
    },
    "requires": {
      "type": "object",
      "properties": {
        "core": { "type": "string", "description": "코어 버전 제약 예: >=1.0.0 (settings.core_version)" },
        "sdk": { "type": "string", "description": "app.addon_sdk.__sdk_version__ 제약" },
        "agents": { "$ref": "#/$defs/stringList", "description": "선행 설치 필요 agent_key (409 missing_requires)" }
      }
    },
    "tables_owned": { "$ref": "#/$defs/stringList", "description": "이 Addon 이 소유하는 테이블. 삭제 시 DROP 대상 (DDL 추출 폴백)" },
    "permissions": { "$ref": "#/$defs/stringList" },
    "worker": {
      "type": "object",
      "properties": {
        "required": { "type": "boolean" },
        "kind": { "type": "string", "enum": ["external", "bundled"] },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "package": { "type": "string", "description": "bundled: addon-agents/zip/{package} (예 VASCA_worker.zip)" },
        "guide": { "type": "string", "description": "{Name}-worker-guide.md" }
      }
    },
    "required_env": { "$ref": "#/$defs/stringList", "description": "미설정 시 설치 경고(missing_env). governance.isolation_required=true 이면 전량 필수" },
    "optional_env": { "$ref": "#/$defs/stringList" },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["verb", "domain"],
        "properties": {
          "verb": { "type": "string" },
          "domain": { "type": "string" },
          "description": { "type": "string" },
          "input_schema": { "type": "object" },
          "output_schema": { "type": "object" },
          "qos": { "type": "object" }
        }
      }
    },
    "governance": {
      "type": "object",
      "properties": {
        "isolation_required": { "type": "boolean", "description": "true → 설치 시 force 확인(409 isolation_confirm) + required_env 전량 필수" },
        "approval": { "type": "string" },
        "data_classification": { "type": "string" },
        "human_approval_required": { "type": "boolean" },
        "audit_level": { "type": "string" }
      }
    },
    "base_agent": { "type": "object" },
    "publisher": { "type": "string" },
    "license": { "type": "string" },
    "key": { "type": "string", "deprecated": true, "description": "레거시 → agent_key" },
    "type": { "type": "string", "deprecated": true, "description": "레거시 → agent_type" },
    "name": { "type": "string", "deprecated": true, "description": "레거시 → display_name" },
    "min_platform_version": { "type": "string", "deprecated": true, "description": "레거시 → requires.core (>=X)" },
    "db_tables": { "deprecated": true, "description": "레거시 → tables_owned" }
  },
  "additionalProperties": true
}
