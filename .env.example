# SeCuardian-Basic — 환경변수 전체 목록 (예시)
# 복사: cp .env.example .env.local → 값 입력 후 사용
# 주의: .env.dev/.env.staging/.env.prod 는 git 미추적 (Vault/Secret Manager 사용 권장)

# ── 앱 기본 ──────────────────────────────────────────────────────────────────
APP_NAME=SeCuardian-Basic
ENV=local                             # local | dev | staging | prod

# ── 데이터베이스 ──────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./local.db     # local: sqlite / dev+: postgresql://...
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── 인증 (JWT) ────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_32_CHARS_MINIMUM   # openssl rand -hex 32 or openssl rand -base64 32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── LLM Provider — Claude (Anthropic) ────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...              # https://console.anthropic.com
ORCHESTRATOR_MODEL=claude-sonnet-4-6
DOMAIN_AGENT_MODEL=claude-haiku-4-5-20251001

# ── LLM Provider — OpenAI (선택) ─────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── LLM Provider — Google Gemini (선택) ──────────────────────────────────────
GOOGLE_API_KEY=AIza...
GOOGLE_MODEL=gemini-1.5-flash

# ── LLM Provider — Ollama (로컬 폴백) ────────────────────────────────────────
# 외부 서버 Ollama 사용 시 http://<외부IP>:11434 + OLLAMA_ENABLED=false (컨테이너 미기동).
# Docker 컨테이너 내부에서 localhost/127.0.0.1 은 host.docker.internal 로 자동 치환됨.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# ── R19-1: Local LLM 다중 백엔드 (ollama|llamacpp|vllm) ──────────────────────
LOCAL_LLM_PROVIDER=ollama
# llama.cpp server (OpenAI 호환 /v1/chat/completions) — compose profile 'llamacpp'
LLAMACPP_BASE_URL=http://localhost:8180
LLAMACPP_MODEL=
# LLAMACPP_PORT=8180
# LLAMACPP_MODEL_FILE=/models/model.gguf   # ./models 디렉터리에 GGUF 배치
# vLLM OpenAI 호환 서버 — compose profile 'vllm' (Linux+NVIDIA 권장)
VLLM_BASE_URL=http://localhost:8100
VLLM_MODEL=
# VLLM_PORT=8100
# R19-4: 히스토리 토큰 예산 (추정 토큰 초과 시 head/tail 축약, 0 이하=무압축)
LLM_CONTEXT_BUDGET=8000
# AI 어시스턴트 tool-call 최대 루프 횟수 (API 오류 자가수정 재시도 상한, 최소 1)
LLM_TOOL_MAX_ROUNDS=6

# ── LLM Gateway — LiteLLM Proxy (선택) ───────────────────────────────────────
# LLM_GATEWAY_URL=http://localhost:4000

# ── Setup Wizard ─────────────────────────────────────────────────────────────
SETUP_COMPLETED=false
DEFAULT_ADMIN_USER_ID=secuardian
DEFAULT_ADMIN_PASSWORD=Secu1234!      # 최초 구동 후 반드시 변경

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:4200","http://example.com"]

# ── 포트 설정 (docker-compose 포트 매핑 및 서비스 기동에 사용) ─────────────────
# 동일 호스트에서 여러 환경 동시 실행 시 충돌 방지를 위해 변경 가능
BACKEND_PORT=8200
FRONTEND_PORT=4200
POSTGRES_PORT=5432
REDIS_PORT=6379
OLLAMA_PORT=11434
# Ollama Docker 실행여부 (실행옵션). false 면 make up/dev 시 Ollama 컨테이너·모델 준비를 전부 스킵.
# 인터넷 미연결/GPU 미보유/네이티브·외부 서버 Ollama 사용 환경에서 false 권장. 미설정 시 기본 true.
# (OLLAMA_BASE_URL 이 외부 호스트면 true 여도 컨테이너를 기동하지 않음)
OLLAMA_ENABLED=true
# Ollama 추론 런타임: cpu(기본) | gpu | mlx
#   gpu: Linux + NVIDIA(+Container Toolkit) — docker-compose.gpu.yml 자동 병합해 호스트 GPU 사용
#   mlx: macOS(Apple Silicon) — Docker 는 Metal 불가 → 네이티브 Ollama/MLX 를 호스트에서 구동
OLLAMA_RUNTIME=cpu
# GPU 개수 (runtime=gpu 시): all(기본) 또는 정수. 특정 GPU 지정은 NVIDIA_VISIBLE_DEVICES 사용
OLLAMA_GPU_COUNT=all
# Ollama 예열: (재)구동 후 첫 토큰 콜드스타트 지연 방지 — 백그라운드 "hi" 선요청으로 모델 상주
OLLAMA_WARMUP_ENABLED=true
OLLAMA_WARMUP_INTERVAL=240   # 초. 주기 재예열(ollama 독립 재구동 대응). 0 이하면 기동 시 1회만

# ── Agent 생성 UI 모드 ────────────────────────────────────────────────────────
# both: 스캐폴딩 + ZIP 업로드 탭 모두 표시 (기본값)
# scaffold: 스캐폴딩 만들기 탭만 표시
# upload: ZIP 업로드 등록 탭만 표시
AGENT_CREATE_MODE=all               # all | both(레거시) | scaffold | upload | marketplace | 쉼표조합 (R21)

# ── Marketplace 연동 (R21) — SeCuardian-Marketplace host 공개 카탈로그 ────────
MARKETPLACE_ENABLED=true              # false 시 마켓플레이스 탭/API 비활성
MARKETPLACE_HOST=localhost            # SeCMP host 주소
MARKETPLACE_PORT=8100                 # SeCMP backend 포트 (SeCMP BACKEND_PORT)
# 지정 시 HOST/PORT 대신 사용 (https 등)
MARKETPLACE_BASE_URL=
# SeCMP MARKETPLACE_HOST_API_KEY 와 일치(설정 시) — 🔴 커밋 금지
MARKETPLACE_API_KEY=
MARKETPLACE_TLS_VERIFY=true           # 사설 CA 사용 시 false
MARKETPLACE_VERIFY_CHECKSUM=true      # 다운로드 ZIP SHA256 검증 강제

# ── MCP 외부 노출 호스트 (Docker/NAT 환경) ───────────────────────────────────
# MCP proxy 포트는 docker-compose.yml에서 20000-20019 범위로 host에 발행됨.
# 비워두면 컨테이너 내부 IP로 자동 감지되어 외부에서 연결 불가 — Docker Compose 환경에서는 필수 지정.
# 같은 머신에서 MCP client 실행 시: MCP_HOST=localhost
# 원격 client에서 접속 시: 이 서버의 실제 LAN IP 또는 도메인
# MCP_HOST=192.168.1.100

# ── MCP 서비스 인증 — Authorization 헤더 없는 MCP tools/call 권한 부여 ────────
# 클라이언트가 x-api-key 헤더로 MCP_API_KEY 를 제시하면 MCP_AUTH_USER(tbl_users
# 실계정)로 JWT(JWT_SECRET_KEY 서명)를 발급해 orchestrator/chat/내장/addon tool 에
# 공통 권한 부여. per-agent 는 MCP 커스텀인자 `api_key:<키>`/`auth_user:<id>` 가 우선.
# 키 생성 예: openssl rand -hex 32 (🔴 JWT_SECRET_KEY 와 다른 값 — 가이드/_meta 에 노출됨)
# MCP_AUTH_USER 미지정 시 키 검증 통과하면 DEFAULT_ADMIN_USER_ID 계정으로 발급.
# MCP_API_KEY=
# MCP_AUTH_USER=admin

# ── Standalone Agent (F12, 선택) ──────────────────────────────────────────────
# AGENT_STANDALONE=false
# AGENT_KEY=example
# AGENT_PORT=8001
# AGENT_BASE_URL=http://localhost:8001
# AGENT_EXPOSE_PROTOCOL=a2a,mcp

# ── Addon 프론트 재빌드 전략 (F10 / D5) ──────────────────────────────────────
# addon 업로드·삭제 후 web(front) 이미지 재빌드 방법.
#   none    : (기본) 재빌드하지 않음 — docker.sock 불필요. 운영자가 make build 로 수동 재빌드
#   compose : api 컨테이너가 docker compose build/up web 실행 — /var/run/docker.sock 마운트 필요
#   webhook : ADDON_WEB_REBUILD_WEBHOOK_URL 로 POST 알림 (CI/K8s 외부 빌더가 처리)
ADDON_WEB_REBUILD=none
# ADDON_WEB_REBUILD_WEBHOOK_URL=

# ── AI Traffic Monitor (ai-traffic-monitor ADDON, E15) ───────────────────────
# 브라우저 AI 도우미(Perplexity/Gemini/ChatGPT/Claude/Copilot) 트래픽 사용량(바이트/패킷) 모니터.
# 미설정 시 코드 기본값 eth0 사용 — 호스트 직접 실행(local)은 실제 NIC(macOS en0 등) 지정 필요.
# snapshot/capture 는 raw 패킷 접근 필요 — 컨테이너는 cap_add: [NET_ADMIN, NET_RAW] 없으면 503(graceful).
AITM_INTERFACE=eth0
# AITM_DOMAINS=perplexity.ai,gemini.google.com,chatgpt.com,claude.ai,api.anthropic.com   # CSV 오버라이드(선택)
# AITM_CAPTURE_DIR=/tmp/ai-traffic
# AITM_MAX_CAPTURE_SEC=60
# AITM_MAX_SNAPSHOT_SEC=30
